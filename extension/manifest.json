{
  "manifest_version": 3,
  "name": "起点 · 离线新标签页",
  "version": "1.0.0",
  "description": "新建标签页打开起点个人启动页，优先使用扩展内置离线资源，启动失败时回退到 www.nyqking.top。",
  "minimum_chrome_version": "111",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "extension-icons/icon16.png",
    "32": "extension-icons/icon32.png",
    "48": "extension-icons/icon48.png",
    "128": "extension-icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self';"
  }
}
